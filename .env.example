# Copie para .env e preencha. Nunca versionar o .env.
UPSELLER_BASE_URL=https://openapi.upseller.com
UPSELLER_CLIENT_ID=
UPSELLER_API_TOKEN=
UPSELLER_LANGUAGE=pt

# Limite de requisições por minuto (plano Profissional = 100; padrão conservador 60)
RATE_LIMIT_PER_MINUTE=60

# Sincronização
DB_PATH=data/estoque.db
SYNC_INTERVAL_MINUTES=60
SYNC_WINDOW_START=08:30
SYNC_WINDOW_END=16:30
SYNC_WEEKDAYS=mon,tue,wed,thu,fri

# Interface web (somente local)
WEB_HOST=127.0.0.1
WEB_PORT=8000
